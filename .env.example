# ── Django ───────────────────────────────────────
SECRET_KEY=substitua-por-uma-chave-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=seuapp.railway.app
CSRF_TRUSTED_ORIGINS=https://seuapp.railway.app

# ── Banco de dados (Railway PostgreSQL) ──────────
# Preenchido automaticamente pelo addon Railway PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# ── Object Storage (Railway Object Storage — variáveis auto-injetadas) ───────
# No Railway: New → Database → Add Object Storage
# As variáveis abaixo são preenchidas automaticamente pelo addon.
# Você só precisa adicionar USE_S3=True manualmente nas Variables do serviço.
USE_S3=True
AWS_ACCESS_KEY_ID=auto-injetado-pelo-railway
AWS_SECRET_ACCESS_KEY=auto-injetado-pelo-railway
AWS_S3_BUCKET_NAME=auto-injetado-pelo-railway
AWS_ENDPOINT_URL_S3=auto-injetado-pelo-railway
# Domínio CDN customizado (opcional — Railway não fornece CDN nativo)
AWS_S3_CUSTOM_DOMAIN=
 