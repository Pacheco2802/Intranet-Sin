# ── Django ───────────────────────────────────────
SECRET_KEY=substitua-por-uma-chave-longa-e-aleatoria
DEBUG=False
ALLOWED_HOSTS=seuapp.railway.app
CSRF_TRUSTED_ORIGINS=https://seuapp.railway.app

# ── Banco de dados (Railway PostgreSQL) ──────────
# Preenchido automaticamente pelo addon Railway PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# ── Cloudflare R2 (arquivos de mídia) ────────────
USE_R2=True
R2_ACCESS_KEY_ID=seu-access-key-id
R2_SECRET_ACCESS_KEY=seu-secret-access-key
R2_BUCKET_NAME=sinsaude-intranet
R2_ENDPOINT_URL=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# Domínio público do bucket (ex: media.seudominio.com.br) — opcional
R2_CUSTOM_DOMAIN=
